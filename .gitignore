# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# cr-renderer is a separate, external open-source project
# (https://github.com/CyberAgentAILab/cr-renderer), pulled in locally for
# reference/dev and installed by the engines via
# `pip install git+https://github.com/CyberAgentAILab/cr-renderer` — not
# vendored into this repo.
/cr-renderer/

# Generated run artifacts
output/*
!output/.gitkeep

# Local LLM weights (H4)
engine/models/

# Docker run outputs
output_docker/

# Local agent tooling
.tycho/

# Generated viewers (regenerate with engine.trace / scripts/showcase.py)
/trace/
/showcase/
/eval/blind/
/eval/blind_refine/
/eval/grader_labels/

# Agent worktrees
/.claude/

# Generated evaluation data (rebuild with eval/arena/sets.py and eval/corpus/build_corpus.py)
/eval/arena/sets/
/eval/arena/ledger.jsonl
/eval/corpus/previews/
